# Production / serious local use:
# use a dedicated Solana RPC. Helius' free tier is enough to get started and
# unlocks the indexed token-account method TrenchScan can use for holder counts.
#
# Example:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
#
# Public Solana RPC remains a fallback for basic development, but it frequently
# throttles holder/history reads and should not be used for a judge/live demo.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. If omitted, @solana/web3.js derives wss:// from SOLANA_RPC_URL.
SOLANA_WS_URL=

# Optional. Jupiter Price v3 is used as a market-cap fallback when an exact
# launch-curve calculation is not available. Leave blank to use Jupiter's
# low-rate keyless endpoint during development; set a free key for production.
JUPITER_API_KEY=
